<Project Sdk="Microsoft.NET.Sdk">
  <!-- SDK-style project so it builds with the .NET SDK. Targets .NET Framework 4.6.2 (Playnite 10). -->
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>PlayniteGameOverlay</RootNamespace>
    <AssemblyName>PlayniteNextOverlay</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultItems>false</EnableDefaultItems>
    <Deterministic>true</Deterministic>
    <DebugType>full</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <NoWarn>$(NoWarn);CS0472;CS0168;CS0169;CS0414;CS0649;CS1998;CS4014;CS0067;CS0618</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="PlayniteSDK" Version="6.12.0" />
    <PackageReference Include="SharpDX" Version="4.2.0" />
    <PackageReference Include="SharpDX.XInput" Version="4.2.0" />
    <PackageReference Include="System.Text.Json" Version="9.0.3" />
    <PackageReference Include="System.ValueTuple" Version="4.5.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Management" />
    <Reference Include="System.Net" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="BatteryManager.cs" />
    <Compile Include="ButtonActions.cs" />
    <Compile Include="ButtonItem.cs" />
    <Compile Include="GameStateManager.cs" />
    <Compile Include="Logger.cs" />
    <Compile Include="GlobalKeyboardHook.cs" />
    <Compile Include="OverlaySettingsView.xaml.cs">
      <DependentUpon>OverlaySettingsView.xaml</DependentUpon>
    </Compile>
    <Compile Include="OverlayWindow.xaml.cs">
      <DependentUpon>OverlayWindow.xaml</DependentUpon>
    </Compile>
    <Compile Include="OverlayWindowViewModel.cs" />
    <Compile Include="PlayniteGameOverlay.cs" />
    <Compile Include="PlayniteAchievementsReader.cs" />
    <Compile Include="AchievementListViewModel.cs" />
    <Compile Include="GameProcessSuspender.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Battery.xaml.cs">
      <DependentUpon>Battery.xaml</DependentUpon>
    </Compile>
    <Compile Include="Properties\SDL2.cs" />
    <Compile Include="WindowHelper.cs" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="App.xaml" />
    <Page Include="OverlaySettingsView.xaml" />
    <Page Include="OverlayWindow.xaml" />
    <Page Include="Battery.xaml" />
  </ItemGroup>

  <ItemGroup>
    <None Include="app.config" />
    <None Include="extension.yaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="icon.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Localization\*.xaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="assets\*.png" />
  </ItemGroup>
</Project>
