<UserControl x:Class="PlayniteGameOverlay.OverlaySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PlayniteGameOverlay" xmlns:System="clr-namespace:System;assembly=mscorlib">

    <UserControl.Resources>
        <ObjectDataProvider x:Key="ControllerShortcutEnum" 
                    MethodName="GetValues" 
                    ObjectType="{x:Type System:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:ControllerShortcut"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="CloseBehaviorEnum" 
                    MethodName="GetValues" 
                    ObjectType="{x:Type System:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:CloseBehavior"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="AspectRatioEnum" 
                    MethodName="GetValues" 
                    ObjectType="{x:Type System:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:AspectRatio"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <local:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="800">
            <TextBlock Text="Playnite Next Overlay" 
                   FontWeight="Bold" 
                   FontSize="16" 
                   Margin="0,0,0,15"/>

            <TextBlock Text="Controller Shortcut:" 
                   Margin="0,0,0,5"/>
            <ComboBox ItemsSource="{Binding Source={StaticResource ControllerShortcutEnum}}"
          SelectedItem="{Binding ControllerShortcut}"
          Width="270"
          HorizontalAlignment="Left"
          Margin="0,0,0,15">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Text>
                                <Binding Path="." Converter="{StaticResource EnumDescriptionConverter}" />
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="Close Game Behavior:" 
         Margin="0,0,0,5"/>
            <ComboBox ItemsSource="{Binding Source={StaticResource CloseBehaviorEnum}}"
                SelectedItem="{Binding CloseBehavior}"
                Width="270"
                HorizontalAlignment="Left"
                Margin="0,0,0,15">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Text>
                                <Binding Path="." Converter="{StaticResource EnumDescriptionConverter}" />
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="If you use the Guide button to open the overlay, turn off Guide-button detection in Steam, Xbox Game Bar, and Playnite (the setting named Show Playnite when the Guide button is pressed)." TextWrapping="Wrap"
           Margin="0,0,0,20" Foreground="#888888" />
            <TextBlock Text="Keyboard shortcut: Alt+` (backtick, usually the key just left of 1)." 
           Margin="0,0,0,20" Foreground="#888888"/>
            <TextBlock Text="Cover Shape:" 
           Margin="0,0,0,5"/>
            <ComboBox ItemsSource="{Binding Source={StaticResource AspectRatioEnum}}"
            SelectedItem="{Binding AspectRatio}"
            Width="270"
            HorizontalAlignment="Left"
            Margin="0,0,0,15">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Text>
                                <Binding Path="." Converter="{StaticResource EnumDescriptionConverter}" />
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <CheckBox IsChecked="{Binding DebugMode}" 
                  Content="Enable Debug Mode" 
                  Margin="0,10,0,5"/>
            <TextBlock Text="Shows extra information in the overlay when a game will not close, and writes a lot of messages to the debugger." 
                   Margin="0,0,0,15"
                   Foreground="#888888"/>

            <TextBlock Text="Overlay views" FontSize="18" />
            <CheckBox IsChecked="{Binding SuspendGameInOverlayViews}" 
                  Content="Pause the game while the achievement list is open" 
                  Margin="0,10,0,5"/>
            <TextBlock Text="Pauses the running game while the full achievement list is open, and resumes it when you return to the main overlay, hide the overlay, quit the game, or close Playnite. Open the list by clicking the recent-achievement panel, or by selecting it and pressing A. Turn this off if a game misbehaves after being paused, for example if the audio glitches." 
                   TextWrapping="Wrap"
                   Margin="0,0,0,20"
                   Foreground="#888888"/>

            <TextBlock Text="Buttons" FontSize="18" />
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,15" Foreground="#888888">
                Shortcuts use SendKeys syntax: ^ is Ctrl, + is Shift, and % is Alt. Add {WIN} to hold the Windows key, which SendKeys cannot send on its own.
                See the <Hyperlink NavigateUri="https://learn.microsoft.com/en-us/dotnet/api/system.windows.forms.sendkeys.send?view=windowsdesktop-9.0" RequestNavigate="Hyperlink_RequestNavigate">SendKeys reference</Hyperlink>.
                A shortcut button appears only when its box is not empty.
                A fresh install uses the NVIDIA App's standard keys. Leave the captures folder empty to open your Videos folder, and the browser path empty to open your default browser.
            </TextBlock>

            <!-- Screenshot toggle -->
            <CheckBox IsChecked="{Binding ShowScreenshot}" 
          Content="Show the Screenshot button" 
          Margin="0,10,0,5"/>
            <Grid Margin="20,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Shortcut:" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding ScreenshotShortcut}"/>
            </Grid>

            <!-- Recording gameplay toggle -->
            <CheckBox IsChecked="{Binding ShowRecordGameplay}" 
          Content="Show the Record button" 
          Margin="0,10,0,5"/>
            <Grid Margin="20,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Shortcut:" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding RecordGameplayShortcut}"/>
            </Grid>

            <!-- Instant Replay (toggle) toggle -->
            <CheckBox IsChecked="{Binding ShowInstantReplay}" 
          Content="Show the Instant replay button" 
          Margin="0,10,0,5"/>
            <Grid Margin="20,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Shortcut:" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding InstantReplayShortcut}"/>
            </Grid>

            <!-- Record recent gameplay toggle -->
            <CheckBox IsChecked="{Binding ShowRecordRecent}" 
          Content="Show the Recent clip button" 
          Margin="0,10,0,5"/>
            <Grid Margin="20,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Shortcut:" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding RecordRecentShortcut}"/>
            </Grid>

            <!-- Streaming toggle -->
            <CheckBox IsChecked="{Binding ShowStreaming}" 
          Content="Show the Stream button" 
          Margin="0,10,0,5"/>
            <Grid Margin="20,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Shortcut:" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding StreamingShortcut}"/>
            </Grid>

            <!-- Performance overlay toggle -->
            <CheckBox IsChecked="{Binding ShowPerformanceOverlay}" 
          Content="Show the Performance button" 
          Margin="0,10,0,5"/>
            <Grid Margin="20,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Shortcut:" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding PerformanceOverlayShortcut}"/>
            </Grid>

            <!-- Screenshot gallery toggle -->
            <CheckBox IsChecked="{Binding ShowScreenshotGallery}" 
          Content="Show the Captures button" 
          Margin="0,10,0,5"/>
            <Grid Margin="20,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Folder:" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding ScreenshotGalleryPath}"/>
            </Grid>

            <!-- Web browser toggle -->
            <CheckBox IsChecked="{Binding ShowWebBrowser}" 
          Content="Show the Browser button" 
          Margin="0,10,0,5"/>
            <Grid Margin="20,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Browser:" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding WebBrowserPath}"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>